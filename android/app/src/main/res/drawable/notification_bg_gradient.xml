<?xml version="1.0" encoding="utf-8"?>
<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="rectangle">

    <!-- Richer emerald gradient - more visible against dark notification shade -->
    <gradient
        android:startColor="#1A5C4E"
        android:centerColor="#1E6B5A"
        android:endColor="#154D42"
        android:angle="135" />

    <corners android:radius="14dp" />

    <!-- Visible golden border -->
    <stroke
        android:width="1.5dp"
        android:color="#55C9A96E" />
</shape>
