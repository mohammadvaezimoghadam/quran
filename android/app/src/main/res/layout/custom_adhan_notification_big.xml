<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="#1B4D3E"
    android:orientation="horizontal"
    android:padding="16dp">

    <!-- Stop Adhan Button (Left side) -->
    <ImageView
        android:id="@+id/btn_stop_adhan_big"
        android:layout_width="48dp"
        android:layout_height="48dp"
        android:layout_gravity="center_vertical"
        android:background="#D32F2F"
        android:contentDescription="قطع اذان"
        android:padding="10dp" />

    <!-- Center Text Column -->
    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:layout_gravity="center_vertical"
        android:gravity="center"
        android:orientation="vertical">

        <TextView
            android:id="@+id/notification_title_big"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="اذان"
            android:textColor="#FFFFFF"
            android:textSize="22sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/notification_subtitle_big"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:text="به افق تهران"
            android:textColor="#D4AF37"
            android:textSize="14sp" />

        <TextView
            android:id="@+id/notification_hint"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:text="برای قطع صدای اذان دکمه قرمز را لمس کنید"
            android:textColor="#CCCCCC"
            android:textSize="11sp" />
    </LinearLayout>

    <!-- Mosque Icon (Right side) -->
    <ImageView
        android:id="@+id/icon_mosque_big"
        android:layout_width="40dp"
        android:layout_height="40dp"
        android:layout_gravity="center_vertical"
        android:contentDescription="مسجد" />

</LinearLayout>
