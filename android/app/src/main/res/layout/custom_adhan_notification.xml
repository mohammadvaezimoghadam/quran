<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="#1B4D3E"
    android:orientation="horizontal"
    android:padding="12dp">

    <!-- Stop Adhan Button (Left side) -->
    <ImageView
        android:id="@+id/btn_stop_adhan"
        android:layout_width="44dp"
        android:layout_height="44dp"
        android:layout_gravity="center_vertical"
        android:background="#D32F2F"
        android:contentDescription="قطع اذان"
        android:padding="8dp" />

    <!-- Center Text Column -->
    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:layout_gravity="center_vertical"
        android:gravity="center"
        android:orientation="vertical">

        <TextView
            android:id="@+id/notification_title"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="اذان"
            android:textColor="#FFFFFF"
            android:textSize="18sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/notification_subtitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:text="به افق تهران"
            android:textColor="#D4AF37"
            android:textSize="12sp" />
    </LinearLayout>

    <!-- Mosque Icon (Right side) -->
    <ImageView
        android:id="@+id/icon_mosque"
        android:layout_width="36dp"
        android:layout_height="36dp"
        android:layout_gravity="center_vertical"
        android:contentDescription="مسجد" />

</LinearLayout>
